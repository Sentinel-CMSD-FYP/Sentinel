{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clip metadata and layer manifest",
  "type": "object",
  "required": ["schema_version", "clip_id", "fps", "frame_size", "n_frames", "layers"],
  "properties": {
    "schema_version": {"const": 1},
    "clip_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "frame_size": {
      "type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2
    },
    "n_frames": {"type": "integer", "minimum": 1},
    "video_url": {"type": "string"},
    "camera": {
      "type": "object",
      "description": "Straight down camera facts for metres and m/s (sentinel_ml.geometry). dfov_deg and sensor_aspect are kept when hfov_deg was converted from a diagonal FOV.",
      "required": ["altitude_m", "hfov_deg", "altitude_source"],
      "properties": {
        "model": {"type": "string"},
        "altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "hfov_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180},
        "dfov_deg": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180},
        "sensor_aspect": {"type": "string"},
        "altitude_source": {"enum": ["assumed", "stated", "telemetry"]}
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "type", "label"],
        "properties": {
          "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"enum": ["grid", "points", "tracks", "polygons"]},
          "label": {"type": "string"},
          "units": {"type": "string"},
          "default_visible": {"type": "boolean"},
          "style": {
            "type": "object",
            "description": "Hints for the renderer, e.g. {\"render\": \"arrows\"} or {\"render\": \"heatmap\", \"field\": \"density\"}."
          }
        }
      }
    }
  }
}
