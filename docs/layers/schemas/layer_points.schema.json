{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Points layer: detected head positions per frame (Model B)",
  "type": "object",
  "required": ["schema_version", "clip_id", "layer", "type", "frame_size", "max_age_frames",
               "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "clip_id": {"type": "string", "minLength": 1},
    "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "type": {"const": "points"},
    "frame_size": {
      "type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2
    },
    "max_age_frames": {"type": "integer", "minimum": 1},
    "frames": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]+$"},
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "description": "Rows of [x, y, score] in original-frame pixels, x = column, y = row."
      }
    }
  }
}
